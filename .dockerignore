# Dependencies — cài lại trong container, không copy từ host
node_modules/

# Git metadata — không cần trong build context
.git/
.gitignore

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment — TUYỆT ĐỐI không đưa secret vào image
.env
.env.*

# Test / spec — không cần trong image production
spec/
coverage/

# OS / editor
.DS_Store
.vscode/
.idea/
